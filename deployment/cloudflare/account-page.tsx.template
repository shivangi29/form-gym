'use client';
import {useState} from 'react';
export default function Account(){const [email,setEmail]=useState(''),[password,setPassword]=useState(''),[message,setMessage]=useState(''),[busy,setBusy]=useState(false);async function submit(action:string){setBusy(true);try{const r=await fetch('/api/account',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,...(action==='logout'?{}:{email,password})})});const d=await r.json() as {error?:string,confirmation?:boolean};if(!r.ok){setMessage(d.error||'Account request failed');return}if(d.confirmation){setMessage('Check your email to confirm your account, then sign in here.');return}window.location.assign('/')}catch{setMessage('Account service unavailable. Please retry.')}finally{setBusy(false)}}return <main className="form-panel" style={{maxWidth:520,margin:'60px auto'}}><a href="/">FORM.</a><h1>Your training space</h1><p>Each account has its own plan and progress.</p><form onSubmit={e=>{e.preventDefault();submit('login')}}><label>Email<input type="email" autoComplete="email" required value={email} onChange={e=>setEmail(e.target.value)}/></label><label>Password<input type="password" minLength={8} autoComplete="current-password" required value={password} onChange={e=>setPassword(e.target.value)}/></label><button disabled={busy} type="submit">Sign in</button> <button disabled={busy} type="button" onClick={()=>submit('signup')}>Create account</button></form><p role="status">{message}</p><button disabled={busy} onClick={()=>submit('logout')}>Sign out on this device</button></main>}
