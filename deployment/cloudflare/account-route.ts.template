import {authConfig,authRequest,setSession,clearSession} from '@/lib/identity';
import {cookies} from 'next/headers';
import {z} from 'zod';
export async function POST(r:Request){try{const {site}=authConfig();if(r.headers.get('origin')!==new URL(site).origin)return Response.json({error:'Request origin not allowed'},{status:403});const b=z.object({action:z.enum(['login','signup','logout']),email:z.string().email().optional(),password:z.string().min(8).max(200).optional()}).parse(await r.json());if(b.action==='logout'){const token=(await cookies()).get('form_access')?.value;if(token)await authRequest('logout',{},token).catch(()=>{});await clearSession();return Response.json({ok:true})}if(!b.email||!b.password)return Response.json({error:'Enter email and password'},{status:400});const response=await authRequest(b.action==='signup'?`signup?redirect_to=${encodeURIComponent(site+'/account')}`:'token?grant_type=password',{email:b.email,password:b.password});if(!response.ok)return Response.json({error:b.action==='login'?'Sign-in failed. Check your details and confirm your email.':'Could not sign up. Try again later or sign in to an existing account.'},{status:response.status===429?429:400});const data=await response.json() as {access_token?:string,refresh_token:string,expires_in:number};if(data.access_token)await setSession({...data,access_token:data.access_token});return Response.json({ok:true,confirmation:!data.access_token},{headers:{'Cache-Control':'no-store'}})}catch(e){return Response.json({error:e instanceof z.ZodError?'Check your email and password (at least 8 characters).':'Account service is unavailable. Check hosting configuration.'},{status:400})}}
